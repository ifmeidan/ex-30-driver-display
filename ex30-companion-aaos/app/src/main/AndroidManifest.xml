<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AAOS gating: app only installs on Automotive head units. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Required for a templated (Car App Library) app: the head unit must
         provide the car-app templates host. Play requires this declared for the
         Automotive OS templated listing (pairs with Ex30CarAppService). -->
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="true" />

    <!-- Vehicle property reads — Normal tier (auto-granted at install). -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY_PORTS" />


    <!-- Vehicle property reads — Dangerous tier (runtime prompt). -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <!-- Pi bridge (Phase 3+). Declared now so the manifest is the single source
         of truth and reviewers see the full surface from day one. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- v0.1.3: requestNetwork() needs CHANGE_NETWORK_STATE (normal,
         install-time grant). Used by BridgeClient to actively hold the
         no-internet ex30-pi WiFi Network so AAOS actually routes bridge
         TCP through wlan0 instead of cellular. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <!-- Auto-start BridgeService on head unit wake so the Pi pipeline runs
         without requiring the driver to open MainActivity each trip. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.AppCompat.DayNight">

        <!-- Required by the Car App Library host for the templated
             CarAppService (Ex30CarAppService). -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- android.car is on the system framework path but not a public shared
             library, so required="false" is mandatory or install fails on every
             AAOS build. -->
        <uses-library
            android:name="android.car"
            android:required="false"
            tools:replace="android:required" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ex30Companion.Main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CarAppActivity: the Car App Library host activity that renders
             Ex30CarAppService's templated Session. Play requires a templated
             Automotive OS app to declare it. Provided by androidx.car.app:
             app-automotive. Declared as a launcher so the templated surface is
             reachable; MainActivity above stays the launcher for the custom
             driver display. -->
        <activity
            android:name="androidx.car.app.activity.CarAppActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <activity
            android:name=".RationaleActivity"
            android:exported="false" />

        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Templated Car App Library service whose sole purpose is to declare
             the IOT car-app category Play requires for the Automotive listing.
             The real UI is MainActivity (the LAUNCHER activity above). -->
        <service
            android:name=".Ex30CarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <!-- directBootAware: receiver runs before the user profile is
             unlocked so we catch LOCKED_BOOT_COMPLETED on head-unit wake. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
